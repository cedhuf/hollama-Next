# Port exposed on the host machine
HOST_PORT=4173

# Comma-separated list of domains allowed to access the app
# Useful when running behind a reverse proxy
# Default: localhost only
VITE_ALLOWED_HOSTS=localhost

# Origins the web fetch tool may read (comma-separated). Empty = any public host;
# private, loopback and link-local addresses are always refused.
# FETCH_ALLOWED_ORIGINS=

# Origins an MCP server may be reached at (comma-separated). Empty = any public
# host, and a server on a private address cannot be added at all. Naming an
# origin here is how a hub on the same machine or the same LAN becomes reachable,
# and it is deliberately an instance decision rather than a per-account one.
# MCP_ALLOWED_ORIGINS=http://localhost:3000

# Web search (optional). When set, the backend is locked instance-wide and shown
# read-only in the GUI. If left unset, it is configured from the admin panel and
# can be shared with, or overridden by, each user.
# PUBLIC_SEARCH_URL=http://localhost:4444
# PUBLIC_SEARCH_BACKEND=degoog          # degoog (default) | searxng
# SEARCH_TOKEN=                          # optional bearer token for a protected instance (kept server-side)

# Attached documents (PDF, Word, spreadsheets) are read in the browser and never
# uploaded. Set this to remove the feature instance-wide: the section disappears
# from settings and no user can turn it back on.
# PUBLIC_DISABLE_DOCUMENTS=true

# OCR for scanned documents. Left unset, the engine and its language data are
# fetched from a public CDN the first time a user turns OCR on. Point these at
# files you serve yourself for an offline or third-party-free instance.
# Files come from the `tesseract.js-core` and `@tesseract.js-data` packages;
# budget ~30 MB for the engine and 3-11 MB per language.
# PUBLIC_OCR_CORE_PATH=/vendor/tesseract-core
# PUBLIC_OCR_LANG_PATH=/vendor/tesseract-lang
# PUBLIC_OCR_WORKER_PATH=/vendor/tesseract/worker.min.js

# Skip the first-run wizard and the welcome tour entirely, for reproducible
# deploys (PUBLIC_ vars are read in the browser).
# PUBLIC_DISABLE_ONBOARDING=true

# ---------------------------------------------------------------------------
# Accounts and storage
# ---------------------------------------------------------------------------

# With nothing set here, this is a personal instance: no login screen, one
# implicit owner created on first run, everything kept in SQLite. Configure a way
# to sign in below (AUTH_CREDENTIALS or OIDC_ISSUER) and it becomes a shared one,
# with accounts and a login page. There is no separate switch for that: a switch
# and the configuration could disagree, and both ways of disagreeing lock someone
# out or let everyone in.

# Directory holding all mutable state (SQLite DB, etc.). Bind-mount this in
# Docker/Nix to persist everything. Default: ./data
# DATA_DIR=./data

# Secret used to sign sessions (Auth.js) and derive the key that encrypts
# provider API keys. Optional: one is generated on first run and kept in the
# database if you set none. Set it to hold the secret yourself, before first run,
# and generate it with: openssl rand -base64 32
# AUTH_SECRET=

# First-run admin, created when the database has no users yet.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Email + password login (Auth.js Credentials). Accounts are created by the
# admin only: there is no self-registration.
# AUTH_CREDENTIALS=true

# OIDC login (e.g. PocketID, Authentik, Keycloak). Setting OIDC_ISSUER enables it.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=PocketID
# Scopes requested from the IdP. Add the scope that carries your groups/roles
# claim if you use role mapping below.
# OIDC_SCOPE=openid profile email groups
# Auto-create a local user on first OIDC login (default: enabled). Set to false
# to require an admin-created account first.
# OIDC_AUTO_PROVISION=true
# Derive the admin/user role from an OIDC claim (group/scope).
# OIDC_ROLE_CLAIM=groups
# OIDC_ADMIN_VALUE=llooma-admin
# Skip the login page and go straight to the IdP (only when OIDC is the sole
# method). Transparent SSO.
# OIDC_AUTO_REDIRECT=true

# Where the persona store is read from. The instance fetches it on behalf of its
# users, so a browser with no way out still gets a catalogue, and a closed
# network can point this at a mirror of its own.
# PERSONA_STORE_URL=https://llooma.eu/personas/

# Plausible Analytics (optional)
# PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# PUBLIC_PLAUSIBLE_API=https://plausible.io/api/event
