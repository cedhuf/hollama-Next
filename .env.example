# Port exposed on the host machine
HOST_PORT=4173

# Comma-separated list of domains allowed to access the app
# Useful when running behind a reverse proxy
# Default: localhost only
VITE_ALLOWED_HOSTS=localhost

# Plausible Analytics (optional)
# PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# PUBLIC_PLAUSIBLE_API=https://plausible.io/api/event
