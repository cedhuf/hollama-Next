.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example

# Agent worktrees: a full checkout plus its build output, ignored by git and
# therefore invisible until Prettier walks into one and reports a thousand
# generated files it can never fix.
/.claude/worktrees

# Ignore files for PNPM, NPM and YARN
pnpm-lock.yaml
package-lock.json
yarn.lock

# Ignore files for typesafe-i18n auto-generated files
src/i18n/i18n-svelte.ts
src/i18n/i18n-types.ts
src/i18n/i18n-util.async.ts
src/i18n/i18n-util.sync.ts
src/i18n/i18n-util.ts

# Generated from the bundles beside it by `pnpm personas:index`, in a shape the
# script controls. Formatting it here means the committed file and the one the
# script writes disagree, and the CI check that compares them fails forever.
/store/personas/index.json
/store/playbooks/index.json
/docs/public/store

# The docs site is its own project with its own toolchain; it is formatted and
# built from `docs/`, not from here.
/docs/dist
/docs/.astro

# MDX: indentation carries meaning (four spaces inside a component is an
# indented code block), and Prettier reformats it into exactly that. It broke the
# home page cards once; formatting these by hand is the cheaper trade.
docs/**/*.mdx
