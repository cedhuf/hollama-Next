{
	"name": "llooma",
	"version": "0.19.0",
	"private": true,
	"homepage": "https://github.com/cedhuf/llooma",
	"description": "A minimal LLM chat app that runs entirely in your browser",
	"packageManager": "pnpm@11.5.2",
	"scripts": {
		"prepare": "svelte-kit sync && node scripts/copy-pdf-worker.mjs",
		"dev": "concurrently \"typesafe-i18n\" \"vite dev --host\"",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"test": "playwright test --trace on --ignore-snapshots ",
		"screenshots": "SCREENSHOTS=1 PUBLIC_MODE=local playwright test tests/screenshots.test.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"typesafe-i18n": "typesafe-i18n",
		"i18n:status": "node scripts/i18n-status.mjs",
		"check:api": "node scripts/check-api-docs.mjs",
		"personas:index": "node scripts/build-persona-index.mjs",
		"personas:check": "node scripts/build-persona-index.mjs --check",
		"playbooks:index": "node scripts/build-playbook-index.mjs",
		"playbooks:check": "node scripts/build-playbook-index.mjs --check",
		"seed:dev": "node scripts/seed-dev.mjs",
		"docs:dev": "pnpm --dir docs run dev",
		"docs:build": "pnpm --dir docs run build"
	},
	"devDependencies": {
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@lucide/svelte": "^1.17.0",
		"@playwright/test": "^1.50.0",
		"@semantic-release/commit-analyzer": "^11.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^9.2.3",
		"@semantic-release/npm": "^11.0.2",
		"@semantic-release/release-notes-generator": "^12.1.0",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/adapter-node": "^5.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/markdown-it": "^14.0.0",
		"@types/node": "^25.9.2",
		"@types/semver": "^7.7.0",
		"bits-ui": "^2.18.1",
		"codemirror": "^6.0.1",
		"concurrently": "^10.0.3",
		"cross-env": "^10.1.0",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"esbuild": "^0.25.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"highlight.js": "^11.11.1",
		"katex": "^0.17.0",
		"markdown-it": "^14.1.0",
		"markdown-it-texmath": "^1.0.0",
		"ollama": "^0.5.9",
		"openai": "^4.66.1",
		"postcss": "^8.5.15",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"semantic-release": "^23.0.0",
		"semver": "^7.8.3",
		"svelte": "^5.19.3",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.1.1",
		"tailwindcss": "^4.3.3",
		"thememirror": "^2.0.1",
		"tslib": "^2.4.1",
		"typesafe-i18n": "^5.26.2",
		"typescript": "^5.5.0",
		"typescript-eslint": "^8.61.0",
		"vite": "^6.2.3",
		"vite-node": "^3.0.9",
		"yaml": "^2.9.0"
	},
	"optionalDependencies": {
		"@esbuild/darwin-x64": "^0.24.0",
		"@esbuild/win32-x64": "^0.24.0",
		"@rollup/rollup-linux-x64-gnu": "^4.21.3"
	},
	"type": "module",
	"author": {
		"name": "Fernando Maclen",
		"email": "hello@fernando.is",
		"url": "https://fernando.is"
	},
	"dependencies": {
		"@auth/sveltekit": "^1.11.3",
		"@khmyznikov/pwa-install": "^0.6.4",
		"officeparser": "7.5.1",
		"pdfjs-dist": "6.1.200"
	}
}
