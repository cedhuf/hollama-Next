@import 'tailwindcss';

@theme {
	--font-sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
	--font-mono: 'JetBrains Mono', ui-monospace, monospace;

	--color-accent: hsl(var(--hsl-primary));
	--color-shade-0: hsl(var(--hsl-shade-0));
	--color-shade-1: hsl(var(--hsl-shade-1));
	--color-shade-2: hsl(var(--hsl-shade-2));
	--color-shade-3: hsl(var(--hsl-shade-3));
	--color-shade-4: hsl(var(--hsl-shade-4));
	--color-shade-5: hsl(var(--hsl-shade-5));
	--color-shade-6: hsl(var(--hsl-shade-6));
	--color-active: hsl(var(--hsl-text-shade-0));
	--color-base: hsl(var(--hsl-text-shade-1));
	--color-muted: hsl(var(--hsl-text-shade-2));
	--color-positive: hsl(var(--hsl-positive));
	--color-positive-muted: hsl(var(--hsl-positive-muted));
	--color-warning: hsl(var(--hsl-warning));
	--color-warning-muted: hsl(var(--hsl-warning-muted));
	--color-negative: hsl(var(--hsl-negative));
	--color-negative-muted: hsl(var(--hsl-negative-muted));
}

@layer base {
	* {
		border-color: hsl(var(--hsl-shade-5));
	}

	html,
	body {
		/* Lock the viewport so the app never scrolls as a whole page (the inner
		   scrollable areas handle content overflow). Using overflow: hidden instead
		   of position: fixed on <html> avoids catastrophic iOS Safari breakage when
		   the keyboard opens (the dynamic viewport shrinks, but a fixed html element
		   keeps its old size, cutting off content and misplacing the prompt bar). */
		height: 100dvh;
		overflow: hidden;
		overscroll-behavior: none;
	}

	:root {
		/* Single source of truth for the top-bar height, shared by the sidebar
		   header and every chat/persona Header so they line up exactly. */
		--app-header-h: 4rem;
	}

	body {
		color: hsl(var(--hsl-text-shade-1));
		width: 100%;
		/* Fill the area behind the iOS status bar / home indicator with the app shell
		   colour so the notch strip matches the rest of the interface. */
		background-color: hsl(var(--hsl-shade-2));
		-webkit-text-size-adjust: 100%;
	}

	/* Prevent iOS Safari from auto-zooming any input/textarea/select on focus
	   (it does this when the computed font-size is under 16 px). This avoids the
	   entire page "exploding" when the user taps the prompt bar on an iPhone. */
	@media (max-width: 1023px) {
		input,
		textarea,
		select {
			font-size: 16px;
		}
	}

	/* Remove the 300 ms tap delay on interactive elements — only touch is relevant
	   on mobile, so there's no need to wait for a potential double-tap. */
	a,
	button,
	[role='button'],
	input,
	textarea,
	select {
		touch-action: manipulation;
	}
}

/* Shared control style for settings inputs/selects/textareas (one source of
   truth instead of a per-file class string). */
@utility settings-field {
	@apply border-shade-3 bg-shade-0 text-active focus:border-accent w-full rounded-md border px-2.5 py-1.5 text-sm outline-none;
}

@custom-variant dark (&:where([data-color-theme='dark']));

@utility base-input {
	@apply placeholder:text-shade-6 flex w-full bg-transparent px-3 pb-2.5 outline-none disabled:cursor-not-allowed disabled:opacity-50;
}

@utility base-section {
	@apply overflow-scrollbar bg-shade-2 h-full w-full lg:rounded-xl lg:border;
}

@utility base-section-fullscreen {
	@apply base-section bg-shade-1 flex border-spacing-1 flex-col items-center py-20;
}

@utility base-fieldset-container {
	@apply p-4 lg:p-6 xl:p-8;
}

@utility confirm-deletion {
	@apply bg-gradient-to-r from-transparent to-red-50;

	&:where([data-color-theme='dark'], [data-color-theme='dark'] *) {
		@apply bg-gradient-to-r from-transparent to-red-900;
	}
}

@utility confirm-editing {
	@apply bg-gradient-to-r from-transparent to-amber-50;

	&:where([data-color-theme='dark'], [data-color-theme='dark'] *) {
		@apply bg-gradient-to-r from-transparent to-amber-900;
	}
}

@utility text-link {
	@apply hover:text-accent underline underline-offset-4;
}

/* Modal entrance/exit.
   bits-ui stamps `data-state` on the overlay and the content and waits for any
   running animation before unmounting, so the close animation gets to play. The
   backdrop blur rides the overlay's fade, which is why it appears rather than
   snapping on. */
@keyframes modal-overlay-in {
	from {
		opacity: 0;
	}
	to {
		opacity: 1;
	}
}

@keyframes modal-overlay-out {
	from {
		opacity: 1;
	}
	to {
		opacity: 0;
	}
}

@keyframes modal-content-in {
	from {
		opacity: 0;
		transform: translateY(8px) scale(0.98);
	}
	to {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
}

@keyframes modal-content-out {
	from {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
	to {
		opacity: 0;
		transform: translateY(4px) scale(0.99);
	}
}

.modal-overlay[data-state='open'] {
	animation: modal-overlay-in 160ms ease-out;
}

.modal-overlay[data-state='closed'] {
	animation: modal-overlay-out 120ms ease-in;
}

.modal-content[data-state='open'] {
	/* Decelerating curve: the dialog arrives rather than slides to a stop. */
	animation: modal-content-in 200ms cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-content[data-state='closed'] {
	animation: modal-content-out 130ms ease-in;
}

/* On phones the dialog is the screen, so it rises from the bottom edge like a
   sheet instead of zooming from the middle — scaling something full-bleed reads
   as the whole page flexing. */
@media (max-width: 639px) {
	@keyframes modal-content-in {
		from {
			opacity: 0;
			transform: translateY(2.5%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes modal-content-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(1.5%);
		}
	}
}

/* Honour the OS setting: the dialog still appears, just without the movement. */
@media (prefers-reduced-motion: reduce) {
	.modal-overlay[data-state='open'],
	.modal-overlay[data-state='closed'],
	.modal-content[data-state='open'],
	.modal-content[data-state='closed'] {
		animation-duration: 1ms;
	}
}

@utility overflow-scrollbar {
	overflow: auto;
	scrollbar-width: auto;
	scrollbar-color: hsl(var(--hsl-shade-6) / 0.8) transparent;

	&::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}

	&::-webkit-scrollbar-track {
		background: transparent;
	}

	&::-webkit-scrollbar-thumb {
		background: hsl(var(--hsl-shade-6) / 0.8);
		border-radius: 3px;
	}
}

@utility badge {
	@apply border-shade-3 text-muted inline-flex max-w-max items-center rounded-md border px-2 py-0.5 font-mono text-xs;
}

@utility base-icon {
	@apply h-4 w-4;
}

@layer base {
	:root {
		--hsl-primary: 14 80% 60%;
		--hsl-shade-0: 0 0% 100%;
		--hsl-shade-1: 0 0% 96%;
		--hsl-shade-2: 0 0% 92%;
		--hsl-shade-3: 0 0% 88%;
		--hsl-shade-4: 0 0% 84%;
		--hsl-shade-5: 0 0% 80%;
		--hsl-shade-6: 0 0% 76%;
		--hsl-text-shade-0: 0 0% 5%;
		--hsl-text-shade-1: 0 0% 25%;
		--hsl-text-shade-2: 0 0% 50%;
		--hsl-negative: 0 100% 50%;
		--hsl-negative-muted: 0 100% 95%;
		--hsl-warning: 33 95% 44%;
		--hsl-warning-muted: 36 100% 95%;
		--hsl-positive: 161 94% 30%;
		--hsl-positive-muted: 133 100% 95%;
	}

	[data-color-theme='dark'] {
		--hsl-primary: 14 80% 60%;
		--hsl-shade-0: 0 0% 10%;
		--hsl-shade-1: 0 0% 14%;
		--hsl-shade-2: 0 0% 18%;
		--hsl-shade-3: 0 0% 22%;
		--hsl-shade-4: 0 0% 26%;
		--hsl-shade-5: 0 0% 30%;
		--hsl-shade-6: 0 0% 34%;
		--hsl-text-shade-0: 0 0% 95%;
		--hsl-text-shade-1: 0 0% 85%;
		--hsl-text-shade-2: 0 0% 50%;
		--hsl-negative: 0 100% 50%;
		--hsl-negative-muted: 0 100% 10%;
		--hsl-warning: 33 95% 44%;
		--hsl-warning-muted: 30 100% 10%;
		--hsl-positive: 161 94% 30%;
		--hsl-positive-muted: 120 100% 10%;
	}

	[data-theme-style='dracula'] {
		--hsl-primary: 326 100% 74%;
		--hsl-shade-0: 60 30% 99%;
		--hsl-shade-1: 60 25% 95%;
		--hsl-shade-2: 60 20% 91%;
		--hsl-shade-3: 60 17% 87%;
		--hsl-shade-4: 60 15% 83%;
		--hsl-shade-5: 60 13% 79%;
		--hsl-shade-6: 60 11% 75%;
		--hsl-text-shade-0: 231 15% 18%;
		--hsl-text-shade-1: 232 14% 31%;
		--hsl-text-shade-2: 225 15% 44%;
		--hsl-negative-muted: 0 100% 95%;
		--hsl-warning-muted: 36 100% 95%;
		--hsl-positive-muted: 133 100% 95%;
	}

	[data-theme-style='dracula'][data-color-theme='dark'] {
		--hsl-primary: 326 100% 74%;
		--hsl-shade-0: 231 15% 18%;
		--hsl-shade-1: 231 14% 21%;
		--hsl-shade-2: 232 14% 24%;
		--hsl-shade-3: 232 13% 27%;
		--hsl-shade-4: 232 13% 30%;
		--hsl-shade-5: 233 13% 33%;
		--hsl-shade-6: 233 12% 36%;
		--hsl-text-shade-0: 60 30% 96%;
		--hsl-text-shade-1: 60 19% 88%;
		--hsl-text-shade-2: 50 10% 73%;
		--hsl-negative-muted: 0 100% 10%;
		--hsl-warning-muted: 30 100% 10%;
		--hsl-positive-muted: 120 100% 10%;
	}

	[data-theme-style='catppuccin'] {
		--hsl-primary: 267 84% 81%;
		--hsl-shade-0: 220 23% 95%;
		--hsl-shade-1: 220 22% 91%;
		--hsl-shade-2: 220 21% 88%;
		--hsl-shade-3: 220 20% 84%;
		--hsl-shade-4: 220 19% 81%;
		--hsl-shade-5: 220 18% 77%;
		--hsl-shade-6: 220 17% 73%;
		--hsl-text-shade-0: 234 16% 35%;
		--hsl-text-shade-1: 233 13% 41%;
		--hsl-text-shade-2: 233 11% 47%;
		--hsl-negative-muted: 0 100% 95%;
		--hsl-warning-muted: 36 100% 95%;
		--hsl-positive-muted: 133 100% 95%;
	}

	[data-theme-style='catppuccin'][data-color-theme='dark'] {
		--hsl-primary: 267 84% 81%;
		--hsl-shade-0: 240 21% 15%;
		--hsl-shade-1: 240 18% 17%;
		--hsl-shade-2: 240 16% 19%;
		--hsl-shade-3: 240 15% 21%;
		--hsl-shade-4: 240 14% 23%;
		--hsl-shade-5: 240 13% 25%;
		--hsl-shade-6: 240 12% 27%;
		--hsl-text-shade-0: 226 64% 88%;
		--hsl-text-shade-1: 227 35% 80%;
		--hsl-text-shade-2: 228 25% 72%;
		--hsl-negative-muted: 0 100% 10%;
		--hsl-warning-muted: 30 100% 10%;
		--hsl-positive-muted: 120 100% 10%;
	}

	/* Gruvbox: warm, low-saturation retro palette. Its greys are tinted towards
	   orange rather than blue, which is what distinguishes it from the two themes
	   above — so the shade ramps carry a small hue/saturation rather than being
	   neutral. */
	[data-theme-style='gruvbox'] {
		--hsl-primary: 24 88% 45%;
		--hsl-shade-0: 48 87% 88%;
		--hsl-shade-1: 46 68% 84%;
		--hsl-shade-2: 43 59% 81%;
		--hsl-shade-3: 43 47% 77%;
		--hsl-shade-4: 40 38% 73%;
		--hsl-shade-5: 41 33% 68%;
		--hsl-shade-6: 39 24% 66%;
		--hsl-text-shade-0: 0 0% 16%;
		--hsl-text-shade-1: 22 7% 29%;
		--hsl-text-shade-2: 28 11% 44%;
		--hsl-negative: 0 71% 42%;
		--hsl-negative-muted: 0 60% 90%;
		--hsl-warning: 33 90% 38%;
		--hsl-warning-muted: 40 70% 88%;
		--hsl-positive: 100 39% 35%;
		--hsl-positive-muted: 100 35% 88%;
	}

	[data-theme-style='gruvbox'][data-color-theme='dark'] {
		--hsl-primary: 27 99% 55%;
		--hsl-shade-0: 0 0% 16%;
		--hsl-shade-1: 20 3% 19%;
		--hsl-shade-2: 20 5% 22%;
		--hsl-shade-3: 22 6% 25%;
		--hsl-shade-4: 22 7% 29%;
		--hsl-shade-5: 24 9% 33%;
		--hsl-shade-6: 27 10% 36%;
		--hsl-text-shade-0: 48 87% 88%;
		--hsl-text-shade-1: 40 38% 73%;
		--hsl-text-shade-2: 35 17% 59%;
		--hsl-negative: 6 96% 59%;
		--hsl-negative-muted: 0 50% 15%;
		--hsl-warning: 42 95% 58%;
		--hsl-warning-muted: 40 50% 15%;
		--hsl-positive: 61 66% 44%;
		--hsl-positive-muted: 90 40% 15%;
	}

	/* Nord: cool blue-grey. Polar Night for the dark ramp, Snow Storm for the light
	   one, with Frost supplying the accent — bright enough on the dark background,
	   deeper on the light one. */
	[data-theme-style='nord'] {
		--hsl-primary: 213 32% 52%;
		--hsl-shade-0: 218 27% 94%;
		--hsl-shade-1: 218 27% 92%;
		--hsl-shade-2: 216 28% 90%;
		--hsl-shade-3: 219 28% 88%;
		--hsl-shade-4: 218 28% 85%;
		--hsl-shade-5: 219 27% 81%;
		--hsl-shade-6: 219 25% 78%;
		--hsl-text-shade-0: 220 16% 22%;
		--hsl-text-shade-1: 222 16% 28%;
		--hsl-text-shade-2: 220 16% 36%;
		--hsl-negative: 354 42% 56%;
		--hsl-negative-muted: 354 45% 92%;
		--hsl-warning: 14 51% 63%;
		--hsl-warning-muted: 14 50% 92%;
		--hsl-positive: 92 28% 65%;
		--hsl-positive-muted: 92 30% 90%;
	}

	[data-theme-style='nord'][data-color-theme='dark'] {
		--hsl-primary: 193 43% 67%;
		--hsl-shade-0: 220 16% 22%;
		--hsl-shade-1: 219 16% 24%;
		--hsl-shade-2: 222 16% 28%;
		--hsl-shade-3: 220 17% 31%;
		--hsl-shade-4: 220 17% 32%;
		--hsl-shade-5: 222 18% 35%;
		--hsl-shade-6: 220 16% 36%;
		--hsl-text-shade-0: 218 27% 94%;
		--hsl-text-shade-1: 219 28% 88%;
		--hsl-text-shade-2: 210 19% 63%;
		--hsl-negative: 354 42% 56%;
		--hsl-negative-muted: 354 30% 20%;
		--hsl-warning: 14 51% 63%;
		--hsl-warning-muted: 14 30% 20%;
		--hsl-positive: 92 28% 65%;
		--hsl-positive-muted: 92 25% 20%;
	}

	/* Solarized: the one palette designed as a matched light/dark pair, so each mode
	   uses its own canonical base tones rather than an inverted approximation. */
	[data-theme-style='solarized'] {
		--hsl-primary: 205 69% 49%;
		--hsl-shade-0: 44 87% 94%;
		--hsl-shade-1: 44 63% 92%;
		--hsl-shade-2: 46 42% 88%;
		--hsl-shade-3: 45 34% 84%;
		--hsl-shade-4: 45 27% 80%;
		--hsl-shade-5: 45 22% 75%;
		--hsl-shade-6: 45 19% 71%;
		--hsl-text-shade-0: 192 81% 14%;
		--hsl-text-shade-1: 194 14% 40%;
		--hsl-text-shade-2: 186 8% 55%;
		--hsl-negative: 1 71% 52%;
		--hsl-negative-muted: 1 60% 92%;
		--hsl-warning: 18 89% 44%;
		--hsl-warning-muted: 18 70% 90%;
		--hsl-positive: 68 100% 30%;
		--hsl-positive-muted: 68 45% 88%;
	}

	[data-theme-style='solarized'][data-color-theme='dark'] {
		--hsl-primary: 205 69% 49%;
		--hsl-shade-0: 192 100% 11%;
		--hsl-shade-1: 192 87% 12%;
		--hsl-shade-2: 192 81% 14%;
		--hsl-shade-3: 192 76% 16%;
		--hsl-shade-4: 192 71% 19%;
		--hsl-shade-5: 192 66% 22%;
		--hsl-shade-6: 193 63% 25%;
		--hsl-text-shade-0: 46 42% 88%;
		--hsl-text-shade-1: 180 7% 60%;
		--hsl-text-shade-2: 196 13% 45%;
		--hsl-negative: 1 71% 52%;
		--hsl-negative-muted: 1 50% 18%;
		--hsl-warning: 18 89% 44%;
		--hsl-warning-muted: 18 60% 18%;
		--hsl-positive: 68 100% 30%;
		--hsl-positive-muted: 68 50% 15%;
	}

	/* Syntax-highlighting (highlight.js) token colours, driven by colour mode so code
	   stays legible on both the light and dark `shade-0` code background — across every
	   theme style. Replaces highlight.js's bundled stylesheet, which was light-only and
	   washed out in dark mode. Palette = GitHub Primer (proven contrast both ways). */
	:root {
		--hljs-comment: #6e7781;
		--hljs-keyword: #cf222e;
		--hljs-string: #0a3069;
		--hljs-number: #0550ae;
		--hljs-title: #8250df;
		--hljs-built-in: #953800;
		--hljs-tag: #116329;
	}

	[data-color-theme='dark'] {
		--hljs-comment: #8b949e;
		--hljs-keyword: #ff7b72;
		--hljs-string: #a5d6ff;
		--hljs-number: #79c0ff;
		--hljs-title: #d2a8ff;
		--hljs-built-in: #ffa657;
		--hljs-tag: #7ee787;
	}
}

/* highlight.js token → colour mapping (global; these classes only appear inside
   rendered Markdown code blocks). Plain CSS so Tailwind never purges them. */
.hljs-comment,
.hljs-quote {
	color: var(--hljs-comment);
	font-style: italic;
}
.hljs-keyword,
.hljs-selector-tag,
.hljs-literal,
.hljs-doctag,
.hljs-deletion {
	color: var(--hljs-keyword);
}
.hljs-string,
.hljs-regexp,
.hljs-addition,
.hljs-meta .hljs-string {
	color: var(--hljs-string);
}
.hljs-number,
.hljs-variable,
.hljs-template-variable,
.hljs-attr,
.hljs-attribute,
.hljs-bullet,
.hljs-link,
.hljs-selector-attr,
.hljs-selector-pseudo {
	color: var(--hljs-number);
}
.hljs-title,
.hljs-section,
.hljs-name,
.hljs-selector-id,
.hljs-selector-class {
	color: var(--hljs-title);
}
.hljs-built_in,
.hljs-type,
.hljs-params,
.hljs-symbol {
	color: var(--hljs-built-in);
}
.hljs-tag {
	color: var(--hljs-tag);
}
.hljs-meta {
	color: var(--hljs-comment);
}
.hljs-emphasis {
	font-style: italic;
}
.hljs-strong {
	font-weight: 600;
}
