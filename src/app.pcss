@import 'tailwindcss';

@theme {
	--font-sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
	--font-mono: 'JetBrains Mono', ui-monospace, monospace;

	--color-accent: hsl(var(--hsl-primary));
	--color-shade-0: hsl(var(--hsl-shade-0));
	--color-shade-1: hsl(var(--hsl-shade-1));
	--color-shade-2: hsl(var(--hsl-shade-2));
	--color-shade-3: hsl(var(--hsl-shade-3));
	--color-shade-4: hsl(var(--hsl-shade-4));
	--color-shade-5: hsl(var(--hsl-shade-5));
	--color-shade-6: hsl(var(--hsl-shade-6));
	--color-active: hsl(var(--hsl-text-shade-0));
	--color-base: hsl(var(--hsl-text-shade-1));
	--color-muted: hsl(var(--hsl-text-shade-2));
	--color-positive: hsl(var(--hsl-positive));
	--color-positive-muted: hsl(var(--hsl-positive-muted));
	--color-warning: hsl(var(--hsl-warning));
	--color-warning-muted: hsl(var(--hsl-warning-muted));
	--color-negative: hsl(var(--hsl-negative));
	--color-negative-muted: hsl(var(--hsl-negative-muted));
}

@layer base {
	* {
		border-color: hsl(var(--hsl-shade-5));
	}

	html,
	body {
		/* Lock the viewport so the app never scrolls as a whole page (the inner
		   scrollable areas handle content overflow). Using overflow: hidden instead
		   of position: fixed on <html> avoids catastrophic iOS Safari breakage when
		   the keyboard opens (the dynamic viewport shrinks, but a fixed html element
		   keeps its old size, cutting off content and misplacing the prompt bar). */
		height: 100dvh;
		overflow: hidden;
		overscroll-behavior: none;
	}

	:root {
		/* Single source of truth for the top-bar height, shared by the sidebar
		   header and every chat/persona Header so they line up exactly. */
		--app-header-h: 4rem;

		/* How far the page slides to uncover the drawer, and therefore how wide the
		   column's contents are laid out on a phone.

		   One number because three things have to agree on it: the distance the card
		   travels, the width its contents stop at, and nothing else. Written in three
		   places it was a decoration that had to be kept in step with what it covered,
		   which is the fault this file has already been bitten by more than once. */
		--drawer-w: min(84vw, 22rem);

		/* How the page travels when the drawer opens.

		   Slow enough to be followed rather than noticed, and landing softly: the
		   picture rides along with the page, so the movement is large, and a large
		   movement is only comfortable when it is unhurried. */
		--drawer-ms: 340ms;
		--drawer-ease: cubic-bezier(0.32, 0.72, 0, 1);
	}

	body {
		color: hsl(var(--hsl-text-shade-1));
		width: 100%;
		/* Fill the area behind the iOS status bar / home indicator with the app shell
		   colour so the notch strip matches the rest of the interface. */
		background-color: hsl(var(--hsl-shade-2));
		-webkit-text-size-adjust: 100%;
	}

	/* Prevent iOS Safari from auto-zooming any input/textarea/select on focus
	   (it does this when the computed font-size is under 16 px). This avoids the
	   entire page "exploding" when the user taps the prompt bar on an iPhone. */
	@media (max-width: 1023px) {
		input,
		textarea,
		select {
			font-size: 16px;
		}
	}

	/* Remove the 300 ms tap delay on interactive elements — only touch is relevant
	   on mobile, so there's no need to wait for a potential double-tap. */
	a,
	button,
	[role='button'],
	input,
	textarea,
	select {
		touch-action: manipulation;
	}
}

/* Shared control style for settings inputs/selects/textareas (one source of
   truth instead of a per-file class string). */
@utility settings-field {
	@apply border-shade-3 bg-shade-0 text-active focus:border-accent w-full rounded-md border px-2.5 py-1.5 text-sm outline-none;
}

/*
 * A text field that grows with what is in it, so a dialog has one scrollbar.
 *
 * A long prompt in a fixed-height box means scrolling the page to reach the
 * field and then scrolling inside the field to read it, with the wheel changing
 * meaning depending on where the pointer happens to be. The composer solved this
 * for itself long ago; the editors kept the old shape.
 *
 * `min-height` is what a caller sets. No maximum: the dialog scrolls, which is
 * the whole point, and a ceiling here would put the second scrollbar back.
 */
/*
 * A section of the library, tinted from the theme rather than from a palette.
 *
 * Three sections of near-identical cards are hard to tell apart at a glance once
 * the page is scrolled, and a fixed colour each would fight every theme the app
 * ships. So each section takes the accent and turns it: same lightness, same
 * chroma, a different hue. Change the theme and the three move together.
 *
 * `oklch(from …)` is what makes that honest — it is the accent, rotated, not a
 * colour picked to look like it. Where relative colours are unsupported the
 * variable falls back to the accent itself and the sections simply share it,
 * which is exactly what they did before.
 *
 * The tint is deliberately faint. It is a cue for the eye scanning the page, not
 * a category colour to be read, and a library in four colours is a toybox.
 */
@utility library-section {
	--section: var(--color-accent);

	@supports (color: oklch(from red l c h)) {
		--section: oklch(from var(--color-accent) l c calc(h + var(--section-turn, 0)));
	}
}

@utility section-tint {
	border-color: color-mix(in srgb, var(--section) 22%, var(--color-shade-3));
}

@utility field-grow {
	/* Where `field-sizing` is not implemented the field keeps its floor and can be
	   dragged taller, which is what it did before. The handle is dropped only
	   where growing on its own actually works, since a resize handle on a field
	   that already fits its content is a control with nothing to do. */
	resize: vertical;

	@supports (field-sizing: content) {
		field-sizing: content;
		resize: none;
	}
}

@custom-variant dark (&:where([data-color-theme='dark']));

@utility base-input {
	@apply placeholder:text-shade-6 flex w-full bg-transparent px-3 pb-2.5 outline-none disabled:cursor-not-allowed disabled:opacity-50;
}

@utility base-section {
	@apply overflow-scrollbar bg-shade-2 h-full w-full lg:rounded-xl lg:border;
}

@utility base-section-fullscreen {
	@apply base-section bg-shade-1 flex border-spacing-1 flex-col items-center py-20;
}

@utility base-fieldset-container {
	@apply p-4 lg:p-6 xl:p-8;
}

@utility confirm-deletion {
	@apply bg-gradient-to-r from-transparent to-red-50;

	&:where([data-color-theme='dark'], [data-color-theme='dark'] *) {
		@apply bg-gradient-to-r from-transparent to-red-900;
	}
}

@utility confirm-editing {
	@apply bg-gradient-to-r from-transparent to-amber-50;

	&:where([data-color-theme='dark'], [data-color-theme='dark'] *) {
		@apply bg-gradient-to-r from-transparent to-amber-900;
	}
}

@utility text-link {
	@apply hover:text-accent underline underline-offset-4;
}

/* Modal entrance/exit.
   bits-ui stamps `data-state` on the overlay and the content and waits for any
   running animation before unmounting, so the close animation gets to play. The
   backdrop blur rides the overlay's fade, which is why it appears rather than
   snapping on. */
@keyframes modal-overlay-in {
	from {
		opacity: 0;
	}
	to {
		opacity: 1;
	}
}

@keyframes modal-overlay-out {
	from {
		opacity: 1;
	}
	to {
		opacity: 0;
	}
}

@keyframes modal-content-in {
	from {
		opacity: 0;
		transform: translateY(8px) scale(0.98);
	}
	to {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
}

@keyframes modal-content-out {
	from {
		opacity: 1;
		transform: translateY(0) scale(1);
	}
	to {
		opacity: 0;
		transform: translateY(4px) scale(0.99);
	}
}

.modal-overlay[data-state='open'] {
	animation: modal-overlay-in 160ms ease-out;
}

.modal-overlay[data-state='closed'] {
	animation: modal-overlay-out 120ms ease-in;
}

.modal-content[data-state='open'] {
	/* Decelerating curve: the dialog arrives rather than slides to a stop. */
	animation: modal-content-in 200ms cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-content[data-state='closed'] {
	animation: modal-content-out 130ms ease-in;
}

/* On phones the dialog is the screen, so it rises from the bottom edge like a
   sheet instead of zooming from the middle — scaling something full-bleed reads
   as the whole page flexing. */
@media (max-width: 639px) {
	@keyframes modal-content-in {
		from {
			opacity: 0;
			transform: translateY(2.5%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes modal-content-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(1.5%);
		}
	}
}

/* Honour the OS setting: the dialog still appears, just without the movement. */
@media (prefers-reduced-motion: reduce) {
	.modal-overlay[data-state='open'],
	.modal-overlay[data-state='closed'],
	.modal-content[data-state='open'],
	.modal-content[data-state='closed'] {
		animation-duration: 1ms;
	}
}

@utility overflow-scrollbar {
	overflow: auto;
	scrollbar-width: auto;
	scrollbar-color: hsl(var(--hsl-shade-6) / 0.8) transparent;

	&::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}

	&::-webkit-scrollbar-track {
		background: transparent;
	}

	&::-webkit-scrollbar-thumb {
		background: hsl(var(--hsl-shade-6) / 0.8);
		border-radius: 3px;
	}
}

@utility badge {
	@apply border-shade-3 text-muted inline-flex max-w-max items-center rounded-md border px-2 py-0.5 font-mono text-xs;
}

@utility base-icon {
	@apply h-4 w-4;
}

@layer base {
	:root {
		--hsl-primary: 14 80% 60%;
		--hsl-shade-0: 0 0% 100%;
		--hsl-shade-1: 0 0% 96%;
		--hsl-shade-2: 0 0% 92%;
		--hsl-shade-3: 0 0% 88%;
		--hsl-shade-4: 0 0% 84%;
		--hsl-shade-5: 0 0% 80%;
		--hsl-shade-6: 0 0% 76%;
		--hsl-text-shade-0: 0 0% 5%;
		--hsl-text-shade-1: 0 0% 25%;
		--hsl-text-shade-2: 0 0% 50%;
		--hsl-negative: 0 100% 50%;
		--hsl-negative-muted: 0 100% 95%;
		--hsl-warning: 33 95% 44%;
		--hsl-warning-muted: 36 100% 95%;
		--hsl-positive: 161 94% 30%;
		--hsl-positive-muted: 133 100% 95%;
	}

	[data-color-theme='dark'] {
		--hsl-primary: 14 80% 60%;
		--hsl-shade-0: 0 0% 10%;
		--hsl-shade-1: 0 0% 14%;
		--hsl-shade-2: 0 0% 18%;
		--hsl-shade-3: 0 0% 22%;
		--hsl-shade-4: 0 0% 26%;
		--hsl-shade-5: 0 0% 30%;
		--hsl-shade-6: 0 0% 34%;
		--hsl-text-shade-0: 0 0% 95%;
		--hsl-text-shade-1: 0 0% 85%;
		--hsl-text-shade-2: 0 0% 50%;
		--hsl-negative: 0 100% 50%;
		--hsl-negative-muted: 0 100% 10%;
		--hsl-warning: 33 95% 44%;
		--hsl-warning-muted: 30 100% 10%;
		--hsl-positive: 161 94% 30%;
		--hsl-positive-muted: 120 100% 10%;
	}

	[data-theme-style='dracula'] {
		--hsl-primary: 326 100% 74%;
		--hsl-shade-0: 60 30% 99%;
		--hsl-shade-1: 60 25% 95%;
		--hsl-shade-2: 60 20% 91%;
		--hsl-shade-3: 60 17% 87%;
		--hsl-shade-4: 60 15% 83%;
		--hsl-shade-5: 60 13% 79%;
		--hsl-shade-6: 60 11% 75%;
		--hsl-text-shade-0: 231 15% 18%;
		--hsl-text-shade-1: 232 14% 31%;
		--hsl-text-shade-2: 225 15% 44%;
		--hsl-negative-muted: 0 100% 95%;
		--hsl-warning-muted: 36 100% 95%;
		--hsl-positive-muted: 133 100% 95%;
	}

	[data-theme-style='dracula'][data-color-theme='dark'] {
		--hsl-primary: 326 100% 74%;
		--hsl-shade-0: 231 15% 18%;
		--hsl-shade-1: 231 14% 21%;
		--hsl-shade-2: 232 14% 24%;
		--hsl-shade-3: 232 13% 27%;
		--hsl-shade-4: 232 13% 30%;
		--hsl-shade-5: 233 13% 33%;
		--hsl-shade-6: 233 12% 36%;
		--hsl-text-shade-0: 60 30% 96%;
		--hsl-text-shade-1: 60 19% 88%;
		--hsl-text-shade-2: 50 10% 73%;
		--hsl-negative-muted: 0 100% 10%;
		--hsl-warning-muted: 30 100% 10%;
		--hsl-positive-muted: 120 100% 10%;
	}

	[data-theme-style='catppuccin'] {
		--hsl-primary: 267 84% 81%;
		--hsl-shade-0: 220 23% 95%;
		--hsl-shade-1: 220 22% 91%;
		--hsl-shade-2: 220 21% 88%;
		--hsl-shade-3: 220 20% 84%;
		--hsl-shade-4: 220 19% 81%;
		--hsl-shade-5: 220 18% 77%;
		--hsl-shade-6: 220 17% 73%;
		--hsl-text-shade-0: 234 16% 35%;
		--hsl-text-shade-1: 233 13% 41%;
		--hsl-text-shade-2: 233 11% 47%;
		--hsl-negative-muted: 0 100% 95%;
		--hsl-warning-muted: 36 100% 95%;
		--hsl-positive-muted: 133 100% 95%;
	}

	[data-theme-style='catppuccin'][data-color-theme='dark'] {
		--hsl-primary: 267 84% 81%;
		--hsl-shade-0: 240 21% 15%;
		--hsl-shade-1: 240 18% 17%;
		--hsl-shade-2: 240 16% 19%;
		--hsl-shade-3: 240 15% 21%;
		--hsl-shade-4: 240 14% 23%;
		--hsl-shade-5: 240 13% 25%;
		--hsl-shade-6: 240 12% 27%;
		--hsl-text-shade-0: 226 64% 88%;
		--hsl-text-shade-1: 227 35% 80%;
		--hsl-text-shade-2: 228 25% 72%;
		--hsl-negative-muted: 0 100% 10%;
		--hsl-warning-muted: 30 100% 10%;
		--hsl-positive-muted: 120 100% 10%;
	}

	/* Gruvbox: warm, low-saturation retro palette. Its greys are tinted towards
	   orange rather than blue, which is what distinguishes it from the two themes
	   above — so the shade ramps carry a small hue/saturation rather than being
	   neutral. */
	[data-theme-style='gruvbox'] {
		--hsl-primary: 24 88% 45%;
		--hsl-shade-0: 48 87% 88%;
		--hsl-shade-1: 46 68% 84%;
		--hsl-shade-2: 43 59% 81%;
		--hsl-shade-3: 43 47% 77%;
		--hsl-shade-4: 40 38% 73%;
		--hsl-shade-5: 41 33% 68%;
		--hsl-shade-6: 39 24% 66%;
		--hsl-text-shade-0: 0 0% 16%;
		--hsl-text-shade-1: 22 7% 29%;
		--hsl-text-shade-2: 28 11% 44%;
		--hsl-negative: 0 71% 42%;
		--hsl-negative-muted: 0 60% 90%;
		--hsl-warning: 33 90% 38%;
		--hsl-warning-muted: 40 70% 88%;
		--hsl-positive: 100 39% 35%;
		--hsl-positive-muted: 100 35% 88%;
	}

	[data-theme-style='gruvbox'][data-color-theme='dark'] {
		--hsl-primary: 27 99% 55%;
		--hsl-shade-0: 0 0% 16%;
		--hsl-shade-1: 20 3% 19%;
		--hsl-shade-2: 20 5% 22%;
		--hsl-shade-3: 22 6% 25%;
		--hsl-shade-4: 22 7% 29%;
		--hsl-shade-5: 24 9% 33%;
		--hsl-shade-6: 27 10% 36%;
		--hsl-text-shade-0: 48 87% 88%;
		--hsl-text-shade-1: 40 38% 73%;
		--hsl-text-shade-2: 35 17% 59%;
		--hsl-negative: 6 96% 59%;
		--hsl-negative-muted: 0 50% 15%;
		--hsl-warning: 42 95% 58%;
		--hsl-warning-muted: 40 50% 15%;
		--hsl-positive: 61 66% 44%;
		--hsl-positive-muted: 90 40% 15%;
	}

	/* Nord: cool blue-grey. Polar Night for the dark ramp, Snow Storm for the light
	   one, with Frost supplying the accent — bright enough on the dark background,
	   deeper on the light one. */
	[data-theme-style='nord'] {
		--hsl-primary: 213 32% 52%;
		--hsl-shade-0: 218 27% 94%;
		--hsl-shade-1: 218 27% 92%;
		--hsl-shade-2: 216 28% 90%;
		--hsl-shade-3: 219 28% 88%;
		--hsl-shade-4: 218 28% 85%;
		--hsl-shade-5: 219 27% 81%;
		--hsl-shade-6: 219 25% 78%;
		--hsl-text-shade-0: 220 16% 22%;
		--hsl-text-shade-1: 222 16% 28%;
		--hsl-text-shade-2: 220 16% 36%;
		--hsl-negative: 354 42% 56%;
		--hsl-negative-muted: 354 45% 92%;
		--hsl-warning: 14 51% 63%;
		--hsl-warning-muted: 14 50% 92%;
		--hsl-positive: 92 28% 65%;
		--hsl-positive-muted: 92 30% 90%;
	}

	[data-theme-style='nord'][data-color-theme='dark'] {
		--hsl-primary: 193 43% 67%;
		--hsl-shade-0: 220 16% 22%;
		--hsl-shade-1: 219 16% 24%;
		--hsl-shade-2: 222 16% 28%;
		--hsl-shade-3: 220 17% 31%;
		--hsl-shade-4: 220 17% 32%;
		--hsl-shade-5: 222 18% 35%;
		--hsl-shade-6: 220 16% 36%;
		--hsl-text-shade-0: 218 27% 94%;
		--hsl-text-shade-1: 219 28% 88%;
		--hsl-text-shade-2: 210 19% 63%;
		--hsl-negative: 354 42% 56%;
		--hsl-negative-muted: 354 30% 20%;
		--hsl-warning: 14 51% 63%;
		--hsl-warning-muted: 14 30% 20%;
		--hsl-positive: 92 28% 65%;
		--hsl-positive-muted: 92 25% 20%;
	}

	/* Solarized: the one palette designed as a matched light/dark pair, so each mode
	   uses its own canonical base tones rather than an inverted approximation. */
	[data-theme-style='solarized'] {
		--hsl-primary: 205 69% 49%;
		--hsl-shade-0: 44 87% 94%;
		--hsl-shade-1: 44 63% 92%;
		--hsl-shade-2: 46 42% 88%;
		--hsl-shade-3: 45 34% 84%;
		--hsl-shade-4: 45 27% 80%;
		--hsl-shade-5: 45 22% 75%;
		--hsl-shade-6: 45 19% 71%;
		--hsl-text-shade-0: 192 81% 14%;
		--hsl-text-shade-1: 194 14% 40%;
		--hsl-text-shade-2: 186 8% 55%;
		--hsl-negative: 1 71% 52%;
		--hsl-negative-muted: 1 60% 92%;
		--hsl-warning: 18 89% 44%;
		--hsl-warning-muted: 18 70% 90%;
		--hsl-positive: 68 100% 30%;
		--hsl-positive-muted: 68 45% 88%;
	}

	[data-theme-style='solarized'][data-color-theme='dark'] {
		--hsl-primary: 205 69% 49%;
		--hsl-shade-0: 192 100% 11%;
		--hsl-shade-1: 192 87% 12%;
		--hsl-shade-2: 192 81% 14%;
		--hsl-shade-3: 192 76% 16%;
		--hsl-shade-4: 192 71% 19%;
		--hsl-shade-5: 192 66% 22%;
		--hsl-shade-6: 193 63% 25%;
		--hsl-text-shade-0: 46 42% 88%;
		--hsl-text-shade-1: 180 7% 60%;
		--hsl-text-shade-2: 196 13% 45%;
		--hsl-negative: 1 71% 52%;
		--hsl-negative-muted: 1 50% 18%;
		--hsl-warning: 18 89% 44%;
		--hsl-warning-muted: 18 60% 18%;
		--hsl-positive: 68 100% 30%;
		--hsl-positive-muted: 68 50% 15%;
	}

	/* Syntax-highlighting (highlight.js) token colours, driven by colour mode so code
	   stays legible on both the light and dark `shade-0` code background — across every
	   theme style. Replaces highlight.js's bundled stylesheet, which was light-only and
	   washed out in dark mode. Palette = GitHub Primer (proven contrast both ways). */
	:root {
		--hljs-comment: #6e7781;
		--hljs-keyword: #cf222e;
		--hljs-string: #0a3069;
		--hljs-number: #0550ae;
		--hljs-title: #8250df;
		--hljs-built-in: #953800;
		--hljs-tag: #116329;
	}

	[data-color-theme='dark'] {
		--hljs-comment: #8b949e;
		--hljs-keyword: #ff7b72;
		--hljs-string: #a5d6ff;
		--hljs-number: #79c0ff;
		--hljs-title: #d2a8ff;
		--hljs-built-in: #ffa657;
		--hljs-tag: #7ee787;
	}
}

/* highlight.js token → colour mapping (global; these classes only appear inside
   rendered Markdown code blocks). Plain CSS so Tailwind never purges them. */
.hljs-comment,
.hljs-quote {
	color: var(--hljs-comment);
	font-style: italic;
}
.hljs-keyword,
.hljs-selector-tag,
.hljs-literal,
.hljs-doctag,
.hljs-deletion {
	color: var(--hljs-keyword);
}
.hljs-string,
.hljs-regexp,
.hljs-addition,
.hljs-meta .hljs-string {
	color: var(--hljs-string);
}
.hljs-number,
.hljs-variable,
.hljs-template-variable,
.hljs-attr,
.hljs-attribute,
.hljs-bullet,
.hljs-link,
.hljs-selector-attr,
.hljs-selector-pseudo {
	color: var(--hljs-number);
}
.hljs-title,
.hljs-section,
.hljs-name,
.hljs-selector-id,
.hljs-selector-class {
	color: var(--hljs-title);
}
.hljs-built_in,
.hljs-type,
.hljs-params,
.hljs-symbol {
	color: var(--hljs-built-in);
}
.hljs-tag {
	color: var(--hljs-tag);
}
.hljs-meta {
	color: var(--hljs-comment);
}
.hljs-emphasis {
	font-style: italic;
}
.hljs-strong {
	font-weight: 600;
}

/* Landing on a message chosen from search: a brief wash of the accent, then
   gone. It answers "which one" and then stops asking for attention. */
.message--found {
	animation: message-found 2s ease-out;
	border-radius: 0.5rem;
}

@keyframes message-found {
	0%,
	40% {
		background-color: color-mix(in srgb, var(--color-accent) 18%, transparent);
	}
	100% {
		background-color: transparent;
	}
}

/*
 * Wallpaper.
 *
 * Blurred once, here, on a layer of its own, rather than by every surface that
 * happens to sit over it.
 *
 * The surfaces below were built to blur the app's own content, which moves, so
 * they use `backdrop-filter` and pay for it on every frame. A picture does not
 * move: blurring it sixty times a second buys nothing. And `backdrop-filter`
 * brought two faults with it that no arrangement of values could settle. Two of
 * them side by side blur their own share of the backdrop and draw a seam where
 * they meet. One of them on a clipped box blanks the backdrop of everything
 * inside it, which is why a rounded column and a frosted card could not both
 * work: clip the column and the card had nothing left to blur, leave it unclipped
 * and a square fill hung out past a round outline.
 *
 * Blurring the source removes both at once. The columns keep only their tint,
 * which is what carried the hierarchy anyway, and `backdrop-filter` is left to
 * the only surfaces with a real reason for it: the cards that hover over moving
 * text.
 *
 * The layer is inset by the blur radius, otherwise the kernel reaches past the
 * picture's edge, finds nothing, and fades the border of the screen.
 */
@layer components {
	:root {
		--wallpaper-blur: calc(18px * var(--wallpaper-strength, 1));
	}

	:root[data-wallpaper='on'] .app-shell::before {
		content: '';
		position: absolute;
		inset: calc(-1 * var(--wallpaper-blur));
		z-index: 0;
		background-image: var(--wallpaper);
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
		filter: blur(var(--wallpaper-blur));
	}

	/*
	 * The picture, again, under a phone's page.
	 *
	 * On a phone the page is an opaque card that slides aside to uncover the column,
	 * and that opacity is not decoration: it is the lid. Take it away and the page
	 * shows the column through itself, which is why every attempt to make the card
	 * translucent ended in a state-dependent background and a flash at the moment it
	 * switched.
	 *
	 * So the card keeps its lid and paints the picture itself. It stops being a
	 * question of what shows through and becomes a question of what is drawn, which
	 * has no state and therefore no moment to get wrong. The panes inside then filter
	 * this the way they filter the canvas everywhere else, and the top bar gets its
	 * translucency back for the same reason it has it on a desktop.
	 *
	 * Only on a phone. On a desktop the card is a transparent frame standing on the
	 * canvas, and a second copy of the picture inside it would be the picture twice.
	 */
	@media (max-width: 1023px) {
		/*
		 * The picture belongs to the card, so the card paints it.
		 *
		 * Not a layer of its own carrying `filter: blur()`, which is what this was and
		 * what WebKit would not cut to the corner. A filtered layer is composited
		 * separately, and neither the card's rounded `overflow` nor a radius given to
		 * the layer itself reached it: the picture kept a square corner and sat in the
		 * notch the card had just cut. Firefox honoured both, which is how this looked
		 * right everywhere except the one engine every phone in the house runs.
		 *
		 * A background painted by an element is clipped by that element's own
		 * border-radius, by construction, with nothing composited in between. The blur
		 * then comes from `backdrop-filter` on a plain overlay, which is the mechanism
		 * every surface in this app already uses and which WebKit has been clipping
		 * correctly all along. The bug is not worked around: the thing it affects is no
		 * longer used.
		 */
		:root[data-wallpaper='on'] .app-card {
			background-image: var(--wallpaper);
			background-position: center;
			background-repeat: no-repeat;
			background-size: cover;
		}

		/* Inset by nothing, so there is no overhang needing a corner of its own and the
		   edges of the blur are the card's own edges. */
		:root[data-wallpaper='on'] .app-card::before {
			content: '';
			position: absolute;
			inset: 0;
			z-index: 0;
			backdrop-filter: blur(var(--wallpaper-blur));
		}

		/*
		 * The slide itself, and the only place its timing is written.
		 *
		 * `translate`, not `transform`: Tailwind v4 writes its translate utilities to
		 * the standalone property, so naming `transform` here transitions something
		 * nothing sets, and the card arrives instantly with no complaint from anyone.
		 * The blanket `transition-all` this replaced covered it by covering everything,
		 * which is exactly how the difference stayed invisible.
		 */
		.app-card {
			transition:
				translate var(--drawer-ms) var(--drawer-ease),
				border-radius var(--drawer-ms) var(--drawer-ease),
				box-shadow var(--drawer-ms) var(--drawer-ease);
		}

		/* A long, travelling animation is exactly the kind someone turns off. */
		@media (prefers-reduced-motion: reduce) {
			.app-card {
				transition: none;
			}
		}

		/*
		 * The page carries its picture with it, and that is the honest version.
		 *
		 * Holding the picture still while the page moved over it meant translating the
		 * layer back by exactly what the card moved forward, every frame, with a
		 * heavily blurred layer on one side of the subtraction. The arithmetic is
		 * right and the result is not: the two never quite cancel on a real device,
		 * and what you see is the background drifting under a page that is supposed to
		 * be sliding over it.
		 *
		 * So nothing is compensated. The page is a sheet with the picture printed on
		 * it, it travels as one thing, and the only thing that has to be right is the
		 * travelling itself.
		 */
	}

	/*
	 * The room a floating bar keeps from the edges of the page it stands on.
	 *
	 * One rule because there is one band, whichever page you are on: the
	 * conversation's pill and the round control the headerless pages carry sit at
	 * the same height and the same distance from the side. They said so by both
	 * spelling out the same four values, which is an agreement only for as long as
	 * nobody edits one of them.
	 *
	 * A wide screen widens the gutter, and that stays where it is used, since it is
	 * the conversation's own margin rather than anything about the bar.
	 */
	.floating-band {
		padding-inline: 1rem;
		padding-top: calc(1rem + env(safe-area-inset-top));
		padding-bottom: 0.5rem;
	}

	/* Over a flat canvas a hairline border separates the columns; over a picture it
	   does not, and they read as holes cut in it rather than as panels on it. */
	:root[data-wallpaper='on'] .app-panel {
		box-shadow:
			0 10px 30px -10px rgb(0 0 0 / 0.35),
			0 2px 8px -3px rgb(0 0 0 / 0.2);
	}
}

/*
 * Translucent surfaces.
 *
 * Three levels, and the whole app draws from them: `surface-chrome` for what frames
 * the content (a top bar, a footer), `surface-pane` for the body it frames,
 * `surface-floating` for a card that hovers over the content it acts on. The first
 * two are tint alone; only the third filters what is behind it, because it is the
 * only one with something behind it that moves. The gaps
 * between them are what read as a hierarchy, so the values live together here —
 * raising a blur in one place and forgetting the others is how a set of surfaces
 * stops looking like a set.
 *
 * Two of them are enough for the sidebar: its edges, then everything between them.
 * A third, splitting the controls from the list underneath, was tried and dropped —
 * two levels four points apart read as a column, three levels two points apart read
 * as a smear.
 *
 * Each level states its reference (`--surface-tint` and `--surface-blur`, what it
 * looks like at the middle of the settings slider) and how far the slider moves
 * it (`--surface-tint-range`, `--surface-blur-range`). The two move together and
 * in the same direction: down is glass, see-through and barely blurred, up is
 * tint, dense and heavily blurred. Either alone is unusable — see-through without
 * blur leaves two texts fighting, blur without transparency is just paint.
 *
 * The ranges deliberately stop short of opaque. Fully solid is the switch's job,
 * and it also turns `backdrop-filter` off, which a slider pretending to reach the
 * same place would not. The levels never cross either: chrome stays above pane at
 * every point of the slider, not merely at its middle, so the hierarchy holds
 * wherever it sits.
 *
 * `--surface-color` is the tint a surface sits on, so a card over the conversation
 * can use a different shade without leaving the system.
 */
@layer components {
	/* On the root, not on the surfaces: a value declared on the element itself
	   would win over the one the settings set here, and the slider would move
	   nothing. */
	:root {
		--surface-strength: 1;
	}

	.surface-chrome,
	.surface-column,
	.surface-pane,
	.surface-floating {
		--surface-color: var(--color-shade-1);
		background-color: color-mix(
			in srgb,
			var(--surface-color)
				calc(var(--surface-tint) + var(--surface-tint-range) * (var(--surface-strength) - 1)),
			transparent
		);
	}

	/*
	 * Only what hovers over moving content filters its backdrop.
	 *
	 * The column materials have nothing of their own to blur: they are neighbours,
	 * so nothing passes behind them, and the one thing that used to justify their
	 * filter, the wallpaper, is now blurred at the source. A card over a
	 * conversation is the opposite case, and the only one left.
	 */
	.surface-floating {
		backdrop-filter: blur(
			calc(var(--surface-blur) + var(--surface-blur-range) * (var(--surface-strength) - 1))
		);
	}

	/**
	 * Frames the content: 94%, from 89% to 99%.
	 *
	 * The densest of them, and the only one that has to read as an edge rather than
	 * as a surface. It used to sit two points above its neighbour, back when the
	 * blur carried the rest of the distance; now that the picture is blurred at the
	 * source, the tint is on its own and has to say the whole thing.
	 *
	 * Every range below is five points, and that is the load-bearing part: unequal
	 * ranges close the gaps as the slider rises, and a hierarchy that holds only in
	 * the middle of its own control is not one. Whatever the distances between the
	 * levels are, they are the same wherever the slider sits.
	 */
	.surface-chrome {
		--surface-tint: 94%;
		--surface-tint-range: 5%;
	}

	/**
	 * The sidebar's own body: 91%, from 86% to 96%.
	 *
	 * Between the bars that frame the column and the conversation beside it, and
	 * that is what it is for: the search, the tabs and the list of conversations are
	 * not the frame, and they are not the thing being read either.
	 *
	 * Not halfway between the two, deliberately. Three points below the bars and
	 * nine above the conversation: the column reads as one material lightly stepped,
	 * while the gap that has to be obvious, between the column and what sits beside
	 * it, keeps nearly the whole of the old distance.
	 */
	.surface-column {
		--surface-tint: 91%;
		--surface-tint-range: 5%;
	}

	/**
	 * The body those bars frame: 82%, from 77% to 87%.
	 *
	 * The level whose floor has to stay legible over a photograph rather than over
	 * more of the app. It can afford to sit lower than it did: what shows through
	 * it is a picture already blurred at the source, which text survives far better
	 * than a sharp one.
	 */
	.surface-pane {
		--surface-tint: 82%;
		--surface-tint-range: 5%;
	}

	/**
	 * Hovers over it, so it blurs hardest: 76% and 18px, from 66%/10px to 86%/26px.
	 *
	 * The one level a caller is meant to lighten on the spot, by overriding
	 * `--surface-tint`, because two cards over the same conversation are not
	 * necessarily the same weight. The conversation's own bar does exactly that: it
	 * carries a title and a date, the composer carries what you are writing, and ten
	 * points between them says which one is the subject without adding a rule, a
	 * shadow or a border to say it.
	 */
	.surface-floating {
		--surface-color: var(--color-shade-0);
		--surface-tint: 76%;
		--surface-tint-range: 10%;
		--surface-blur: 18px;
		--surface-blur-range: 8px;
	}

	/*
	 * Nothing behind but the app's own canvas.
	 *
	 * A surface reveals what is under it, and under a column there is only a flat
	 * colour of the app's own. Revealing it gains nothing, costs a filtered layer on
	 * every frame, and — because the tint being mixed is not that colour — shifts
	 * every shade of the theme by a hair. Which is exactly what it looks like: a
	 * palette that is almost right.
	 *
	 * So the column materials are simply opaque until there is a picture worth
	 * showing. `surface-floating` is not one of them: it hovers over the
	 * conversation, and what it reveals is the conversation, wallpaper or not.
	 *
	 * Written as `:not([data-wallpaper='on'])` rather than `='off'` so the first
	 * paint, before the attribute is set, is already the opaque one.
	 */
	:root:not([data-wallpaper='on']) .surface-chrome,
	:root:not([data-wallpaper='on']) .surface-column,
	:root:not([data-wallpaper='on']) .surface-pane {
		background-color: var(--surface-color);
	}

	:root[data-transparency='off'] .surface-chrome,
	:root[data-transparency='off'] .surface-column,
	:root[data-transparency='off'] .surface-pane,
	:root[data-transparency='off'] .surface-floating {
		background-color: var(--surface-color);
		backdrop-filter: none;
	}

	@media (prefers-reduced-transparency: reduce) {
		.surface-chrome,
		.surface-column,
		.surface-pane,
		.surface-floating {
			background-color: var(--surface-color);
			backdrop-filter: none;
		}
	}
}
